---
import { t } from '../../utils/i18n';

export interface Props {
    lang: string;
}

const { lang } = Astro.props;
---
<section class="hero" id="hero" data-cam="0">
    <div class="hero-main">
        <div class="hero-top">
            <div class="eyebrow" data-rv="fade"><span class="dot"></span>{t('hero.eyebrow', lang)}</div>
            <h1 class="display h-hero">
                <span class="mask-line"><span>{t('hero.title', lang)}</span></span>
                <span class="mask-line hero-tagline"><span>{t('hero.subtitle', lang)}</span></span>
            </h1>
            <p class="hero-sub body" data-rv="up">{t('hero.description', lang)}</p>
            <div class="hero-cta" data-rv="up">
                <a class="btn btn-primary" href="#contact">Book a consultation</a>
                <a class="btn btn-ghost" href="#services">Explore services</a>
            </div>
        </div>

        <a class="peek" href="#pathways" data-view="3" data-rv="fade" data-cursor aria-label="Preview: Sanmon, before the bell">
            <span class="peek-fr" data-frame></span>
            <span class="peek-play"><svg viewBox="0 0 22 22" fill="none"><path d="M8 5.6 16.4 11 8 16.4z" fill="#dfe7e0"/></svg></span>
            <span class="peek-cap"><b class="jp">山門</b><i>Sanmon — before the bell</i></span>
        </a>
    </div>

    <div class="hero-footer">
        <div class="hero-cue" data-rv="fade"><span>Scroll to enter</span><span class="track"><i></i></span></div>
        <div class="chapters" id="chips">
            <div class="chip" data-chip="0" data-rv="up" data-cursor><span class="num">01</span>
                <span class="tx"><b>Thresholds</b><p>Discover the hidden gates that open on to deeper paths.</p></span></div>
            <div class="chip" data-chip="1" data-rv="up" data-cursor><span class="num">02</span>
                <span class="tx"><b>Still Gardens</b><p>Witness the courts where silence gently unfolds.</p></span></div>
            <div class="chip" data-chip="2" data-rv="up" data-cursor><span class="num">03</span>
                <span class="tx"><b>Sacred Craft</b><p>Embrace the hands and heritage that shape devotion.</p></span></div>
            <div class="chip" data-chip="3" data-rv="up" data-cursor><span class="num">04</span>
                <span class="tx"><b>Night Rituals</b><p>Explore the rites that awaken when the day is done.</p></span></div>
        </div>
    </div>

    <div class="word-fb" aria-hidden="true">SAIC</div>

    <div class="hero-side" data-rv="up">
        <span class="v jp">影の道</span>
    </div>
</section>

<style lang="scss">
.hero{ position:relative; min-height:100svh; padding:0 var(--pad); display:flex; flex-direction:column; overflow:hidden; }
.hero::before{ content:''; position:absolute; left:0; right:0; top:0; height:46%; pointer-events:none;
  background:linear-gradient(rgba(3,6,9,.72), rgba(3,6,9,.34) 46%, transparent); }

/* main row: copy left, peek right, vertically centred in the free space */
.hero-main{
  flex:1 1 auto; position:relative; z-index:2;
  display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,.6fr);
  align-items:center; gap:clamp(32px,5vw,96px);
  padding:calc(var(--nav-h) + clamp(24px,5vh,64px)) 0 clamp(32px,6vh,72px);
}
.hero-top{ width:clamp(40vw,56vw,1040px); max-width:100%; }

.hero-top .eyebrow{ display:flex; align-items:center; gap:10px; margin-bottom:clamp(18px,2.4vh,28px);
  font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--bone-dim); }
.hero-top .eyebrow .dot{ flex:0 0 auto; width:5px; height:5px; border-radius:50%; background:var(--vermilion); box-shadow:0 0 10px var(--vermilion); }

.hero h1{
  margin:0 0 clamp(20px,3vh,32px);
  font-size:clamp(44px,5.6vw,104px);
  line-height:1;
  letter-spacing:-.03em;
  font-weight:600;
  text-wrap:balance;
  text-shadow:0 2px 30px rgba(3,6,8,.85);
}
.hero h1 .mask-line{ display:block; }
.hero h1 .hero-tagline{
  margin-top:.35em;
  font-size:.5em;
  font-weight:300;
  letter-spacing:-.01em;
  line-height:1.15;
  color:var(--bone-dim);
}

.hero-sub{
  max-width:52ch;
  font-size:clamp(15px,1.1vw,19px);
  line-height:1.6;
  color:var(--bone-dim);
  text-shadow:0 1px 26px rgba(3,6,8,.95);
}

.hero-cta{ display:flex; flex-wrap:wrap; gap:12px; margin-top:clamp(24px,3.5vh,40px); }
.btn{
  display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:0 22px;
  font-size:12px; font-weight:500; letter-spacing:.14em; text-transform:uppercase; text-decoration:none;
  border:1px solid transparent; border-radius:2px;
  transition:background-color .3s, color .3s, border-color .3s;
}
.btn-primary{ background:var(--bone); color:#05080b; }
.btn-primary:hover{ background:#fff; }
.btn-ghost{ color:var(--bone); border-color:var(--line); }
.btn-ghost:hover{ border-color:var(--bone-dim); }

/* the floating window, now a grid cell */
.peek{
  position:relative; justify-self:end; width:100%; max-width:320px; display:block;
  transition:transform .8s var(--ease-out);
}
.peek-fr{ display:block; aspect-ratio:16/10;
  background:linear-gradient(180deg, rgba(3,6,9,.04) 24%, rgba(3,6,9,.48) 100%),
    url('assets/images/amsterdam.webp') center / cover no-repeat;
  outline:1px solid rgba(223,231,224,.16); outline-offset:-1px;
  box-shadow:0 34px 70px -30px rgba(0,0,0,.9); transition:outline-color .5s; }
.peek:hover{ transform:translate3d(0,-5px,0); }
.peek:hover .peek-fr{ outline-color:rgba(223,231,224,.42); }
.peek-play{ position:absolute; top:0; right:0; left:0; bottom:auto; aspect-ratio:16/10;
  display:grid; place-items:center; pointer-events:none; }
.peek-play svg{ width:clamp(30px,3.2vw,46px); height:auto; filter:drop-shadow(0 2px 12px rgba(0,0,0,.7));
  transition:transform .55s var(--ease-out); }
.peek:hover .peek-play svg{ transform:scale(1.14); }
.peek-cap{ display:flex; align-items:baseline; gap:9px; margin-top:9px; }
.peek-cap b{ font-size:11px; font-weight:400; letter-spacing:.24em; color:var(--bone-dim); }
.peek-cap i{ font-style:normal; font-size:9px; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); }

/* footer: full-width chapter row */
.hero-footer{ padding-bottom:clamp(22px,4.2vh,42px); position:relative; z-index:2; }
.hero-cue{ display:flex; align-items:center; justify-content:flex-end; gap:12px; margin-bottom:14px;
  font-size:9px; letter-spacing:.3em; text-transform:uppercase; color:var(--muted); }
.hero-cue .track{ width:54px; height:1px; background:var(--line); position:relative; overflow:hidden; }
.hero-cue .track i{ position:absolute; inset:0; background:var(--bone); transform-origin:left;
  animation:cue 2.8s var(--ease-io) infinite; }
.chapters{
  display:grid; grid-template-columns:repeat(4,1fr); gap:clamp(14px,2.4vw,40px);
  border-top:1px solid var(--line-soft); padding-top:18px;
}
.chip{ display:flex; gap:14px; align-items:flex-start; cursor:pointer; }
.chip .num{ line-height:1; flex:0 0 auto; transition:color .4s, transform .5s var(--ease-out); }
.chip .tx{ min-width:0; padding-top:3px; }
.chip b{ display:block; font-size:11px; font-weight:500; letter-spacing:.2em; text-transform:uppercase;
  color:var(--bone-dim); margin-bottom:6px; transition:color .4s;
  text-shadow:0 1px 16px rgba(3,6,8,.9); }
.chip p{ margin:0; font-size:13px; line-height:1.5; color:var(--bone-dim); opacity:.75; max-width:28ch;
  transition:color .4s, opacity .4s; }
.chip:hover .num{ color:var(--ember); transform:translate3d(0,-2px,0); }
.chip:hover b{ color:var(--bone); }
.chip:hover p{ opacity:1; }
.chip.on .num{ color:var(--ember); }
.chip.on b{ color:var(--bone); }

/* oversized outlined watermark behind the copy */
.word-fb{
  position:absolute; left:0; right:0; bottom:-.12em; z-index:1; pointer-events:none;
  font-size:clamp(120px,24vw,420px); font-weight:700; line-height:1; letter-spacing:-.04em;
  text-align:center; white-space:nowrap; user-select:none;
  color:transparent; -webkit-text-stroke:1px rgba(223,231,224,.06);
}

.hero-side{
  position:absolute; z-index:2; right:calc(var(--pad) / 2); top:50%; transform:translateY(-50%);
  display:flex; flex-direction:column; align-items:center; gap:14px; pointer-events:none;
}
.hero-side .v{ writing-mode:vertical-rl; font-size:13px; letter-spacing:.62em; color:rgba(223,231,224,.5); }
@media (min-width:1101px){ .peek{ margin-right:clamp(24px,3vw,56px); } }
@media (max-width:1100px){ .hero-side{ display:none; } }

@media (max-width:820px){
  .hero-main{ grid-template-columns:1fr; justify-items:center; text-align:center;
    padding-top:calc(var(--nav-h) + 24px); }
  .hero-top{ width:100%; }
  .hero-top .eyebrow{ display:block; font-size:10px; line-height:1.8; }
  .hero-top .eyebrow .dot{ display:inline-block; vertical-align:middle; margin-right:10px; }
  .hero h1{ font-size:clamp(36px,10vw,60px); }
  .hero-sub{ margin-inline:auto; max-width:38ch; }
  .hero-cta{ justify-content:center; }
  .peek{ display:none; }
  .hero-cue{ justify-content:center; }
  .chapters{ grid-template-columns:repeat(2,1fr); row-gap:24px; text-align:left; }
}
@media (max-width:480px){
  .chapters{ display:flex; overflow-x:auto; scroll-snap-type:x mandatory; gap:20px;
    margin-inline:calc(var(--pad) * -1); padding-inline:var(--pad); scrollbar-width:none; }
  .chip{ flex:0 0 72%; scroll-snap-align:start; }
  .hero-cta .btn{ flex:1 1 100%; }
}

@keyframes cue{ 0%{transform:scaleX(0)} 42%{transform:scaleX(1)} 100%{transform:scaleX(1) translateX(100%)} }
</style>
